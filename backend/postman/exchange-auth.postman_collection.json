          "mode": "raw",
          "raw": "{\n  \"username\": \"Someone Else\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 Signup - email is case-insensitive",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Same email in upper case must still be treated as a duplicate",
              "pm.request.body.update(JSON.stringify({",
              "  username: \"Someone Else\",",
              "  email: pm.collectionVariables.get(\"testEmail\").toUpperCase(),",
              "  password: pm.collectionVariables.get(\"testPassword\"),",
              "}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Message is \\\"Email is already registered\\\"\", () => pm.expect(pm.response.json().message).to.eql(\"Email is already registered\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
